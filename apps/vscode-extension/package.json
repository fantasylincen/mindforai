{
  "name": "mindforai",
  "displayName": "MindForAI",
  "description": "在 VS Code、TRAE 等兼容 IDE 中直接打开 .toon / .json 白板文档，支持保存与格式化编辑。",
  "version": "1.0.0",
  "publisher": "mindforai",
  "license": "MIT",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "mindforai",
    "mindmap",
    "whiteboard",
    "ai-documentation"
  ],
  "icon": "media/icon.png",
  "main": "./extension.js",
  "activationEvents": [
    "onCustomEditor:mindforai.editor",
    "onCustomEditor:mindforai.jsonEditor",
    "onCommand:mindforai.openWithEditor",
    "onCommand:mindforai.newDocument"
  ],
  "contributes": {
    "languages": [
      {
        "id": "toon",
        "aliases": [
          "MindForAI",
          "toon"
        ],
        "extensions": [
          ".toon"
        ],
        "icon": {
          "light": "./media/icon.png",
          "dark": "./media/icon.png"
        }
      },
      {
        "id": "mindforai",
        "aliases": [
          "MindForAI Legacy",
          "mindforai"
        ],
        "extensions": [
          ".mindforai"
        ],
        "icon": {
          "light": "./media/icon.png",
          "dark": "./media/icon.png"
        }
      },
      {
        "id": "drawnixlite",
        "aliases": [
          "DrawnixLite Legacy"
        ],
        "extensions": [
          ".drawnixlite"
        ],
        "icon": {
          "light": "./media/icon.png",
          "dark": "./media/icon.png"
        }
      }
    ],
    "customEditors": [
      {
        "viewType": "mindforai.editor",
        "displayName": "MindForAI 白板",
        "selector": [
          {
            "filenamePattern": "*.toon"
          },
          {
            "filenamePattern": "*.mindforai"
          },
          {
            "filenamePattern": "*.drawnixlite"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "mindforai.jsonEditor",
        "displayName": "MindForAI 白板（JSON）",
        "selector": [
          {
            "filenamePattern": "*.json"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "mindforai.openWithEditor",
        "title": "用 MindForAI 白板打开",
        "category": "MindForAI",
        "icon": "./media/icon.png"
      },
      {
        "command": "mindforai.newDocument",
        "title": "新建 MindForAI 文档",
        "category": "MindForAI",
        "icon": "./media/icon.png"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "mindforai.openWithEditor",
          "when": "resourceExtname == .toon || resourceExtname == .json || resourceExtname == .mindforai || resourceExtname == .drawnixlite",
          "group": "navigation"
        }
      ]
    }
  }
}
