                                            children[1]:
                                              - /workspace # ls -l\\ntotal 94440\\ndrwxr-xr-x   11 root     root          4096 Nov  2 08:20 BeamStreamS3\\ndrwxr-xr-x    5 root     root          4096 Nov  3 12:14 custom-asr\\ndrwxr-xr-x   14 root     root          4096 Nov  3 08:03 drawnix\\ndrwxr-xr-x    6 root     root          4096 Nov  3 18:10 websocket-player\\n/workspace #
